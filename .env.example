# Copy this file to `.env.local` and fill in real values.
# NEXT_PUBLIC_* values are embedded into the bundle at build time, so change
# them before running a build / redeploying.

# Base URL of the backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Clerk ------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Google Maps (optional) -------------------------------------------------
# Browser key restricted by HTTP referrer. Needs "Maps JavaScript API" and
# "Places API" enabled. Without it, address autocomplete and the map are empty
# (booking still works with typed addresses).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Supabase realtime (optional) -------------------------------------------
# Enables live ride updates. Without these the app falls back to 30s polling.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
